{
  "openapi": "3.0.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "HealthController_obtenerHealth",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Estado agregado del walking skeleton (puede ser \"degradado\")"
          }
        },
        "summary": "Reporta el estado real de Postgres, Redis y el último heartbeat del worker",
        "tags": [
          "health"
        ]
      }
    },
    "/system/ping": {
      "post": {
        "description": "Ida y vuelta observable del walking skeleton [R5]. No toca PostgreSQL; el heartbeat se lee luego desde GET /health.",
        "operationId": "SystemPingController_ping",
        "parameters": [],
        "responses": {
          "202": {
            "description": "Trabajo encolado en la cola \"system\""
          }
        },
        "summary": "Encola un trabajo \"system.ping\" procesado por el worker",
        "tags": [
          "system"
        ]
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "AuthController_login",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Login exitoso, cookie seei_session emitida"
          },
          "401": {
            "description": "Credenciales inválidas"
          }
        },
        "summary": "Login con código de usuario y contraseña; emite cookie de sesión httpOnly",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/google": {
      "post": {
        "operationId": "AuthController_loginGoogle",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Login exitoso, cookie seei_session emitida"
          },
          "401": {
            "description": "Credenciales inválidas"
          },
          "409": {
            "description": "Vinculación requerida: reenviar con la contraseña actual confirmada"
          }
        },
        "summary": "Login con Google OAuth restringido a dominios institucionales",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/recovery": {
      "post": {
        "operationId": "AuthController_solicitarRecovery",
        "parameters": [],
        "responses": {
          "202": {
            "description": "Solicitud recibida (respuesta uniforme, no revela si el correo existe)"
          }
        },
        "summary": "Solicita un enlace de recuperación/establecimiento de contraseña",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/recovery/confirm": {
      "post": {
        "operationId": "AuthController_confirmarRecovery",
        "parameters": [],
        "responses": {
          "204": {
            "description": "Contraseña actualizada, sesiones revocadas"
          },
          "400": {
            "description": "Enlace inválido o expirado"
          }
        },
        "summary": "Confirma la recuperación con el token recibido y establece la contraseña nueva",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "AuthController_logout",
        "parameters": [],
        "responses": {
          "204": {
            "description": "Logout procesado"
          }
        },
        "summary": "Cierra la sesión activa (idempotente) y expira la cookie",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/whoami": {
      "get": {
        "operationId": "AuthController_whoami",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Sesión válida"
          },
          "401": {
            "description": "Sin cookie de sesión o sesión inexistente/expirada"
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "summary": "Devuelve la sesión autenticada actual (ejemplo de ruta protegida)",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/usuarios/bloqueados": {
      "get": {
        "operationId": "AuthController_listarBloqueados",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Listado de cuentas bloqueadas",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UsuarioBloqueadoDto"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Sin cookie de sesión válida"
          },
          "403": {
            "description": "Rol distinto de comite"
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "summary": "Lista las cuentas actualmente bloqueadas (panel del comité)",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/usuarios/{id}/desbloquear": {
      "post": {
        "operationId": "AuthController_desbloquear",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Desbloqueo procesado (idempotente)"
          },
          "400": {
            "description": "id malformado"
          },
          "401": {
            "description": "Sin cookie de sesión válida"
          },
          "403": {
            "description": "Rol distinto de comite"
          },
          "404": {
            "description": "Usuario no encontrado"
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "summary": "Desbloquea manualmente una cuenta (panel del comité)",
        "tags": [
          "auth"
        ]
      }
    },
    "/usuarios": {
      "post": {
        "operationId": "UsersController_crear",
        "parameters": [],
        "responses": {
          "201": {
            "description": "Usuario creado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsuarioRespuestaDto"
                }
              }
            }
          },
          "400": {
            "description": "Campo inválido (dni/correo)"
          },
          "401": {
            "description": "Sin cookie de sesión válida"
          },
          "403": {
            "description": "Rol distinto de administrador/director"
          },
          "409": {
            "description": "DNI/código/correo duplicado"
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "summary": "Crea un Usuario para cualquiera de los cinco roles",
        "tags": [
          "usuarios"
        ]
      },
      "get": {
        "operationId": "UsersController_listar",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Listado de usuarios",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UsuarioRespuestaDto"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Filtro rol/estado desconocido"
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "summary": "Lista usuarios, con filtro opcional por rol y estado",
        "tags": [
          "usuarios"
        ]
      }
    },
    "/usuarios/{id}": {
      "get": {
        "operationId": "UsersController_obtenerPorId",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Usuario encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsuarioRespuestaDto"
                }
              }
            }
          },
          "400": {
            "description": "id malformado"
          },
          "404": {
            "description": "Usuario no encontrado"
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "summary": "Consulta un Usuario por id",
        "tags": [
          "usuarios"
        ]
      },
      "patch": {
        "operationId": "UsersController_actualizar",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Usuario actualizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsuarioRespuestaDto"
                }
              }
            }
          },
          "400": {
            "description": "Campo inválido (dni/correo)"
          },
          "404": {
            "description": "Usuario no encontrado"
          },
          "409": {
            "description": "DNI/código/correo duplicado"
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "summary": "Actualiza datos básicos de un Usuario (nunca el estado)",
        "tags": [
          "usuarios"
        ]
      }
    },
    "/usuarios/{id}/estado": {
      "patch": {
        "operationId": "UsersController_cambiarEstado",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Estado actualizado"
          },
          "400": {
            "description": "Estado destino no permitido"
          },
          "404": {
            "description": "Usuario no encontrado"
          },
          "409": {
            "description": "Transición desde bloqueado no permitida"
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "summary": "Cambia el estado activo/inactivo de un Usuario (nunca hacia/desde bloqueado)",
        "tags": [
          "usuarios"
        ]
      }
    },
    "/usuarios/{usuarioId}/apoderados": {
      "post": {
        "operationId": "ApoderadosController_crear",
        "parameters": [],
        "responses": {
          "201": {
            "description": "Apoderado creado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApoderadoRespuestaDto"
                }
              }
            }
          },
          "404": {
            "description": "Usuario no encontrado"
          },
          "409": {
            "description": "El Usuario referenciado no es estudiante"
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "summary": "Crea un Apoderado vinculado a un Usuario con rol estudiante",
        "tags": [
          "apoderados"
        ]
      },
      "get": {
        "operationId": "ApoderadosController_listar",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Listado de apoderados",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ApoderadoRespuestaDto"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Usuario no encontrado"
          },
          "409": {
            "description": "El Usuario referenciado no es estudiante"
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "summary": "Lista los apoderados de un Usuario con rol estudiante",
        "tags": [
          "apoderados"
        ]
      }
    },
    "/usuarios/{usuarioId}/apoderados/{apoderadoId}": {
      "patch": {
        "operationId": "ApoderadosController_actualizar",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Apoderado actualizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApoderadoRespuestaDto"
                }
              }
            }
          },
          "404": {
            "description": "Usuario o Apoderado no encontrado"
          },
          "409": {
            "description": "El Usuario referenciado no es estudiante"
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "summary": "Actualiza datos básicos de un Apoderado",
        "tags": [
          "apoderados"
        ]
      },
      "delete": {
        "operationId": "ApoderadosController_eliminar",
        "parameters": [],
        "responses": {
          "204": {
            "description": "Apoderado eliminado"
          },
          "404": {
            "description": "Usuario o Apoderado no encontrado"
          },
          "409": {
            "description": "El Usuario referenciado no es estudiante"
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "summary": "Elimina físicamente un Apoderado",
        "tags": [
          "apoderados"
        ]
      }
    }
  },
  "info": {
    "title": "SEEI API",
    "description": "Walking skeleton del sistema SEEI (#1)",
    "version": "0.0.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "health",
      "description": ""
    },
    {
      "name": "system",
      "description": ""
    }
  ],
  "servers": [],
  "components": {
    "schemas": {
      "UsuarioBloqueadoDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "ID del usuario bloqueado"
          },
          "nombres": {
            "type": "string",
            "description": "Nombres completos del usuario"
          },
          "dni": {
            "type": "string",
            "description": "DNI del usuario"
          },
          "codigo": {
            "type": "string",
            "description": "Código institucional único del usuario"
          },
          "bloqueado_hasta": {
            "type": "string",
            "description": "Fin del bloqueo (ISO 8601); null si el bloqueo es indefinido",
            "nullable": true
          }
        },
        "required": [
          "id",
          "nombres",
          "dni",
          "codigo",
          "bloqueado_hasta"
        ]
      },
      "UsuarioRespuestaDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "ID del usuario"
          },
          "nombres": {
            "type": "string",
            "description": "Nombres completos"
          },
          "dni": {
            "type": "string",
            "description": "DNI"
          },
          "codigo": {
            "type": "string",
            "description": "Código institucional único"
          },
          "correo": {
            "type": "string",
            "description": "Correo electrónico"
          },
          "rol": {
            "type": "string",
            "description": "Rol del usuario",
            "enum": [
              "estudiante",
              "docente",
              "comite",
              "administrador",
              "director"
            ]
          },
          "estado": {
            "type": "string",
            "description": "Estado del usuario",
            "enum": [
              "activo",
              "inactivo",
              "bloqueado"
            ]
          },
          "creado_en": {
            "type": "string",
            "description": "Fecha de creación (ISO 8601)"
          }
        },
        "required": [
          "id",
          "nombres",
          "dni",
          "codigo",
          "correo",
          "rol",
          "estado",
          "creado_en"
        ]
      },
      "ApoderadoRespuestaDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "ID del apoderado"
          },
          "nombres": {
            "type": "string",
            "description": "Nombres completos del apoderado"
          },
          "dni": {
            "type": "string",
            "description": "DNI del apoderado"
          },
          "correo": {
            "type": "string",
            "description": "Correo de contacto del apoderado",
            "nullable": true
          }
        },
        "required": [
          "id",
          "nombres",
          "dni",
          "correo"
        ]
      }
    }
  }
}