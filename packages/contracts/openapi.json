  "info": {
    "title": "SEEI API",
    "description": "Walking skeleton del sistema SEEI (#1)",
    "version": "0.0.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "health",
      "description": ""
    },
    {
      "name": "system",
      "description": ""
    }
  ],
  "servers": [],
  "components": {
    "schemas": {
      "UsuarioBloqueadoDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "ID del usuario bloqueado"
          },
          "nombres": {
            "type": "string",
            "description": "Nombres completos del usuario"
          },
          "dni": {
            "type": "string",
            "description": "DNI del usuario"
          },
          "codigo": {
            "type": "string",
            "description": "Código institucional único del usuario"
          },
          "bloqueado_hasta": {
            "type": "string",
            "description": "Fin del bloqueo (ISO 8601); null si el bloqueo es indefinido",
            "nullable": true
          }
        },
        "required": [
          "id",
          "nombres",
          "dni",
          "codigo",
          "bloqueado_hasta"
        ]
      },
      "UsuarioRespuestaDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "ID del usuario"
          },
          "nombres": {
            "type": "string",
            "description": "Nombres completos"
          },
          "dni": {
            "type": "string",
            "description": "DNI"
          },
          "codigo": {
            "type": "string",
            "description": "Código institucional único"
          },
          "correo": {
            "type": "string",
            "description": "Correo electrónico"
          },
          "rol": {
            "type": "string",
            "description": "Rol del usuario",
            "enum": [
              "estudiante",
              "docente",
              "comite",
              "administrador",
              "director"
            ]
          },
          "estado": {
            "type": "string",
            "description": "Estado del usuario",
            "enum": [
              "activo",
              "inactivo",
              "bloqueado"
            ]
          },
          "creado_en": {
            "type": "string",
            "description": "Fecha de creación (ISO 8601)"
          }
        },
        "required": [
          "id",
          "nombres",
          "dni",
          "codigo",
          "correo",
          "rol",
          "estado",
          "creado_en"
        ]
      },
      "ApoderadoRespuestaDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "ID del apoderado"
          },
          "nombres": {
            "type": "string",
            "description": "Nombres completos del apoderado"
          },
          "dni": {
            "type": "string",
            "description": "DNI del apoderado"
          },
          "correo": {
            "type": "string",
            "description": "Correo de contacto del apoderado",
            "nullable": true
          }
        },
        "required": [
          "id",
          "nombres",
          "dni",
          "correo"
        ]
      },
      "AnioEscolarRespuestaDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "ID del año escolar"
          },
          "nombre": {
            "type": "string",
            "description": "Nombre único del año escolar"
          },
          "activo": {
            "type": "boolean",
            "description": "Indica si es el año escolar activo"
          }
        },
        "required": [
          "id",
          "nombre",
          "activo"
        ]
      },
      "NivelRespuestaDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "ID del nivel"
          },
          "nombre": {
            "type": "string",
            "description": "Nombre único del nivel"
          }
        },
        "required": [
          "id",
          "nombre"
        ]
      },
      "GradoRespuestaDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "ID del grado"
          },
          "nombre": {
            "type": "string",
            "description": "Nombre del grado, único dentro de su Nivel"
          },
          "nivel_id": {
            "type": "string",
            "description": "ID del Nivel al que pertenece el grado"
          }
        },
        "required": [
          "id",
          "nombre",
          "nivel_id"
        ]
      },
      "SeccionRespuestaDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "ID de la sección"
          },
          "nombre": {
            "type": "string",
            "description": "Nombre de la sección, único dentro de (grado_id, anio_escolar_id)"
          },
          "grado_id": {
            "type": "string",
            "description": "ID del Grado al que pertenece la sección"
          },
          "anio_escolar_id": {
            "type": "string",
            "description": "ID del AnioEscolar al que pertenece la sección"
          }
        },
        "required": [
          "id",
          "nombre",
          "grado_id",
          "anio_escolar_id"
        ]
      },
      "AulaRespuestaDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "ID del aula"
          },
          "turno": {
            "type": "string",
            "description": "Turno del aula",
            "enum": [
              "manana",
              "tarde"
            ]
          },
          "grado_id": {
            "type": "string",
            "description": "ID del Grado al que pertenece el aula"
          },
          "seccion_id": {
            "type": "string",
            "description": "ID de la Seccion a la que pertenece el aula"
          },
          "anio_escolar_id": {
            "type": "string",
            "description": "ID del AnioEscolar al que pertenece el aula"
          }
        },
        "required": [
          "id",
          "turno",
          "grado_id",
          "seccion_id",
          "anio_escolar_id"
        ]
      }
    }
  }
}