// Baseline vacía del walking skeleton (#1). Sin modelos de dominio: la migración inicial
// (1.14) sirve como cimiento sobre el que #2 (base-schema-and-migrations) apila sus grupos
// de migraciones. `directUrl` es el mecanismo de Prisma para que Migrate/Introspect usen el
// rol propietario (`seei_migrator`) mientras el Client en runtime usa el rol de aplicación
// (`seei_app`) — ver design.md, sección "Cadenas de conexión".

generator client {
  provider = "prisma-client-js"
}

// `shadowDatabaseUrl` (contingencia verificada en sdd-apply, PR1): `seei_migrator` no tiene el
// atributo CREATEDB (design.md de #1, D5 — rol propietario de esquema, no de clúster), así que
// `prisma migrate dev`/`--create-only` no puede crear su base sombra efímera con ese rol. Se
// apunta al superusuario de bootstrap `postgres` (el mismo que #1 usa solo para el
// aprovisionamiento inicial de roles, nunca para runtime) exclusivamente para esta necesidad de
// tooling de autoría; no cambia los privilegios de `seei_migrator`/`seei_app` en runtime ni en
// `prisma migrate deploy` (que no usa base sombra).
datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  directUrl         = env("MIGRATION_DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// Grupo 1 — Identidad y árbol académico (base-schema-and-migrations, tarea 1.1; design.md D1).
// `onDelete` explícito en toda relación: `Restrict` por omisión, `Cascade` solo en
// `Apoderado → Usuario` (composición pura del registro del estudiante, nunca referenciada por
// `DerechoVoto`/`Voto`). PascalCase sin diacríticos ni `ñ`; columnas snake_case; PK `uuid`.

enum RolUsuario {
  estudiante
  docente
  comite
  administrador
  director
}

enum EstadoUsuario {
  activo
  inactivo
  bloqueado
}

enum Turno {
  manana
  tarde
}

// `password_hash` (auth-server-sessions, PR1; design.md D5/D9): nulable a propósito — un
// `Usuario` sin credencial local (p. ej. provisto solo para OAuth de #5) sigue siendo válido.
model Usuario {
  id            String        @id @default(uuid()) @db.Uuid
  nombres       String
  dni           String        @unique
  codigo        String        @unique
  correo        String        @unique
  rol           RolUsuario
  estado        EstadoUsuario @default(activo)
  creado_en     DateTime      @default(now()) @db.Timestamptz(3)
  password_hash String?

  apoderados       Apoderado[]
  matriculas       Matricula[]
  derechoVotos     DerechoVoto[]
  jobsCorreo       JobCorreo[]
  eventosAuditoria EventoAuditoria[]
}

model Apoderado {
  id         String  @id @default(uuid()) @db.Uuid
  nombres    String
  dni        String
  correo     String?
  usuario_id String  @db.Uuid

  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
}

// NOTE: la unicidad de "a lo sumo un AnioEscolar activo" vive como índice único parcial en SQL
//       raw dentro de prisma/migrations/<ts>_identity_and_academic_tree/migration.sql — Prisma
//       no expresa índices parciales en el DSL.
model AnioEscolar {
  id     String  @id @default(uuid()) @db.Uuid
  nombre String  @unique
  activo Boolean @default(false)

  secciones       Seccion[]
  aulas           Aula[]
  matriculas      Matricula[]
  configuraciones Configuracion[]
}

model Nivel {
  id     String @id @default(uuid()) @db.Uuid
  nombre String @unique

  grados Grado[]
}

model Grado {
  id       String @id @default(uuid()) @db.Uuid
  nombre   String
  nivel_id String @db.Uuid

  nivel     Nivel     @relation(fields: [nivel_id], references: [id], onDelete: Restrict)
  secciones Seccion[]
  aulas     Aula[]

  @@unique([nivel_id, nombre])
}

model Seccion {
  id              String @id @default(uuid()) @db.Uuid
  nombre          String
  grado_id        String @db.Uuid
  anio_escolar_id String @db.Uuid

  grado       Grado       @relation(fields: [grado_id], references: [id], onDelete: Restrict)
  anioEscolar AnioEscolar @relation(fields: [anio_escolar_id], references: [id], onDelete: Restrict)
  aulas       Aula[]

  @@unique([grado_id, anio_escolar_id, nombre])
}

model Aula {
  id              String @id @default(uuid()) @db.Uuid
  turno           Turno
  grado_id        String @db.Uuid
  seccion_id      String @db.Uuid
  anio_escolar_id String @db.Uuid

  grado        Grado         @relation(fields: [grado_id], references: [id], onDelete: Restrict)
  seccion      Seccion       @relation(fields: [seccion_id], references: [id], onDelete: Restrict)
  anioEscolar  AnioEscolar   @relation(fields: [anio_escolar_id], references: [id], onDelete: Restrict)
  matriculas   Matricula[]
  procesoAulas ProcesoAula[]

  @@unique([grado_id, seccion_id, anio_escolar_id])
}

model Matricula {
  id              String @id @default(uuid()) @db.Uuid
  usuario_id      String @db.Uuid
  aula_id         String @db.Uuid
  anio_escolar_id String @db.Uuid

  usuario     Usuario     @relation(fields: [usuario_id], references: [id], onDelete: Restrict)
  aula        Aula        @relation(fields: [aula_id], references: [id], onDelete: Restrict)
  anioEscolar AnioEscolar @relation(fields: [anio_escolar_id], references: [id], onDelete: Restrict)

  @@unique([usuario_id, aula_id, anio_escolar_id])
}

// Grupo 2 — Estructura del proceso electoral (base-schema-and-migrations, tarea 2.1; design.md D1).
// `onDelete` explícito: `Cascade` en `Lista`/`Candidato`/`OpcionConsulta`/`ProcesoAula` hacia
// `ProcesoElectoral` (composición de un proceso descartable en `borrador`, sin `DerechoVoto`
// todavía); `Restrict` en `Candidato → Lista` y `ProcesoAula → Aula` (ninguno de los dos puede
// desvincularse en silencio). Sin SQL raw en este grupo (D4).

enum TipoProceso {
  municipio
  representante_aula
  padres
  consulta
}

enum EstadoProceso {
  borrador
  abierto
  cerrado
  acta_emitida
}

enum EstadoParticipacion {
  activo
  baja
}

model ProcesoElectoral {
  id                      String        @id @default(uuid()) @db.Uuid
  nombre                  String
  descripcion             String?
  tipo                    TipoProceso
  estado                  EstadoProceso @default(borrador)
  fecha_apertura_prevista DateTime      @db.Timestamptz(3)
  fecha_cierre_prevista   DateTime      @db.Timestamptz(3)
  apertura_real           DateTime?     @db.Timestamptz(3)
  cierre_real             DateTime?     @db.Timestamptz(3)
  ocultar_resultados      Boolean       @default(false)
  creado_en               DateTime      @default(now()) @db.Timestamptz(3)

  listas       Lista[]
  candidatos   Candidato[]
  opciones     OpcionConsulta[]
  procesoAulas ProcesoAula[]
  derechoVotos DerechoVoto[]
  votos        Voto[]
  actas        Acta[]
}

model Lista {
  id               String              @id @default(uuid()) @db.Uuid
  proceso_id       String              @db.Uuid
  nombre           String
  numero           Int
  simbolo          String?
  lema             String?
  propuesta        String?
  plan_trabajo_url String?
  estado           EstadoParticipacion @default(activo)
  baja_en          DateTime?           @db.Timestamptz(3)

  proceso    ProcesoElectoral @relation(fields: [proceso_id], references: [id], onDelete: Cascade)
  candidatos Candidato[]
  votos      Voto[]

  @@unique([proceso_id, numero])
}

model Candidato {
  id         String              @id @default(uuid()) @db.Uuid
  proceso_id String              @db.Uuid
  lista_id   String?             @db.Uuid
  nombres    String
  grado      String?
  aula       String?
  cargo      String?
  estado     EstadoParticipacion @default(activo)
  baja_en    DateTime?           @db.Timestamptz(3)

  proceso ProcesoElectoral @relation(fields: [proceso_id], references: [id], onDelete: Cascade)
  lista   Lista?           @relation(fields: [lista_id], references: [id], onDelete: Restrict)
  votos   Voto[]
}

model OpcionConsulta {
  id          String  @id @default(uuid()) @db.Uuid
  proceso_id  String  @db.Uuid
  etiqueta    String
  descripcion String?

  proceso ProcesoElectoral @relation(fields: [proceso_id], references: [id], onDelete: Cascade)
  votos   Voto[]

  @@unique([proceso_id, etiqueta])
}

model ProcesoAula {
  id         String @id @default(uuid()) @db.Uuid
  proceso_id String @db.Uuid
  aula_id    String @db.Uuid

  proceso ProcesoElectoral @relation(fields: [proceso_id], references: [id], onDelete: Cascade)
  aula    Aula             @relation(fields: [aula_id], references: [id], onDelete: Restrict)

  @@unique([proceso_id, aula_id])
}

// Grupo 3 — Núcleo de votación (base-schema-and-migrations, tarea 3.1; design.md D1/D5).
// `onDelete: Restrict` explícito en TODAS las relaciones — ningún camino de borrado alcanza
// `DerechoVoto` ni `Voto` (ADR-0003, ADR-0010). En particular, `Voto → Lista/OpcionConsulta/
// Candidato` anula el `SetNull` por omisión de Prisma en relaciones opcionales (design.md D1,
// "Gotcha que obliga a ser explícito").

model DerechoVoto {
  id            String @id @default(uuid()) @db.Uuid
  proceso_id    String @db.Uuid
  usuario_id    String @db.Uuid
  en_calidad_de String
  aula_snapshot String

  proceso ProcesoElectoral @relation(fields: [proceso_id], references: [id], onDelete: Restrict)
  usuario Usuario          @relation(fields: [usuario_id], references: [id], onDelete: Restrict)
  votos   Voto[]
}

// NOTE: `exactamente una elección` vive como CHECK en SQL raw dentro de
//       prisma/migrations/<ts>_voting_core/migration.sql — Prisma no expresa CHECK.
model Voto {
  id                 String   @id @default(uuid()) @db.Uuid
  proceso_id         String   @db.Uuid
  derecho_voto_id    String   @db.Uuid
  lista_id           String?  @db.Uuid
  opcion_id          String?  @db.Uuid
  candidato_id       String?  @db.Uuid
  blanco             Boolean  @default(false)
  codigo_comprobante String   @unique
  clave_idempotencia String
  hora_servidor      DateTime @default(now()) @db.Timestamptz(3)

  proceso     ProcesoElectoral @relation(fields: [proceso_id], references: [id], onDelete: Restrict)
  derechoVoto DerechoVoto      @relation(fields: [derecho_voto_id], references: [id], onDelete: Restrict)
  lista       Lista?           @relation(fields: [lista_id], references: [id], onDelete: Restrict)
  opcion      OpcionConsulta?  @relation(fields: [opcion_id], references: [id], onDelete: Restrict)
  candidato   Candidato?       @relation(fields: [candidato_id], references: [id], onDelete: Restrict)

  @@unique([proceso_id, derecho_voto_id])
  @@unique([proceso_id, clave_idempotencia])
}

// Grupo 4 — Tablas de soporte (base-schema-and-migrations, tarea 4.1; design.md D1/D7).
// `onDelete: Restrict` en toda relación (artefactos probatorios y singleton institucional, sin
// composición descartable). Sin SQL raw en este grupo (D4). `Configuracion` NO lleva ninguna
// columna de secreto SMTP (D7): solo `smtp_host`/`smtp_puerto`/`smtp_remitente` — la contraseña
// vendrá de variable de entorno o gestor de secretos, decisión de #10.

enum EstadoJobCorreo {
  pendiente
  enviado
  fallido
}

enum TipoNotificacion {
  correo
}

enum TipoActa {
  apertura
  cierre
  resultados
}

enum EstadoActa {
  borrador
  emitida
}

model JobCorreo {
  id         String          @id @default(uuid()) @db.Uuid
  usuario_id String          @db.Uuid
  asunto     String
  cuerpo     String
  estado     EstadoJobCorreo @default(pendiente)
  intentos   Int             @default(0)
  creado_en  DateTime        @default(now()) @db.Timestamptz(3)

  usuario        Usuario        @relation(fields: [usuario_id], references: [id], onDelete: Restrict)
  notificaciones Notificacion[]
}

model Notificacion {
  id            String           @id @default(uuid()) @db.Uuid
  job_correo_id String           @db.Uuid
  tipo          TipoNotificacion @default(correo)
  creado_en     DateTime         @default(now()) @db.Timestamptz(3)

  jobCorreo JobCorreo @relation(fields: [job_correo_id], references: [id], onDelete: Restrict)
}

model Configuracion {
  id              String   @id @default(uuid()) @db.Uuid
  clave           String   @unique
  anio_escolar_id String   @db.Uuid
  smtp_host       String?
  smtp_puerto     Int?
  smtp_remitente  String?
  actualizado_en  DateTime @default(now()) @db.Timestamptz(3)

  anioEscolar AnioEscolar @relation(fields: [anio_escolar_id], references: [id], onDelete: Restrict)
}

model Acta {
  id         String     @id @default(uuid()) @db.Uuid
  proceso_id String     @db.Uuid
  tipo       TipoActa
  estado     EstadoActa @default(borrador)
  contenido  String
  creado_en  DateTime   @default(now()) @db.Timestamptz(3)

  proceso ProcesoElectoral @relation(fields: [proceso_id], references: [id], onDelete: Restrict)
}

// Grupo 5 — Motor de auditoría append-only (append-only-audit-engine, PR1; design.md D1/D2/D3).
// `onDelete: Restrict` explícito en `actor_usuario_id` (anula el `SetNull` por omisión de Prisma
// en relaciones opcionales — mismo gotcha que D1 de #2): un `DELETE` sobre `Usuario` no puede
// vaciar en silencio la autoría de un evento. `event_type`/`entity_type` son `TEXT` (convención
// impuesta por `CHECK`, no `ENUM` — D7); `entity_id` es `TEXT` porque direcciona entidades
// heterogéneas y ninguna FK es posible. Sin índices adicionales: la tabla nace vacía y el camino
// de lectura lo define #21 (D1).
model EventoAuditoria {
  id               String   @id @default(uuid()) @db.Uuid
  actor_usuario_id String?  @db.Uuid
  event_type       String
  entity_type      String
  entity_id        String?
  occurred_at      DateTime @default(now()) @db.Timestamptz(3)
  ip_address       String?  @db.Inet
  user_agent       String?
  payload          Json     @db.JsonB

  actor Usuario? @relation(fields: [actor_usuario_id], references: [id], onDelete: Restrict)
}
