// Baseline vacía del walking skeleton (#1). Sin modelos de dominio: la migración inicial
// (1.14) sirve como cimiento sobre el que #2 (base-schema-and-migrations) apila sus grupos
// de migraciones. `directUrl` es el mecanismo de Prisma para que Migrate/Introspect usen el
// rol propietario (`seei_migrator`) mientras el Client en runtime usa el rol de aplicación
// (`seei_app`) — ver design.md, sección "Cadenas de conexión".

generator client {
  provider = "prisma-client-js"
}

// `shadowDatabaseUrl` (contingencia verificada en sdd-apply, PR1): `seei_migrator` no tiene el
// atributo CREATEDB (design.md de #1, D5 — rol propietario de esquema, no de clúster), así que
// `prisma migrate dev`/`--create-only` no puede crear su base sombra efímera con ese rol. Se
// apunta al superusuario de bootstrap `postgres` (el mismo que #1 usa solo para el
// aprovisionamiento inicial de roles, nunca para runtime) exclusivamente para esta necesidad de
// tooling de autoría; no cambia los privilegios de `seei_migrator`/`seei_app` en runtime ni en
// `prisma migrate deploy` (que no usa base sombra).
datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  directUrl         = env("MIGRATION_DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// Grupo 1 — Identidad y árbol académico (base-schema-and-migrations, tarea 1.1; design.md D1).
// `onDelete` explícito en toda relación: `Restrict` por omisión, `Cascade` solo en
// `Apoderado → Usuario` (composición pura del registro del estudiante, nunca referenciada por
// `DerechoVoto`/`Voto`). PascalCase sin diacríticos ni `ñ`; columnas snake_case; PK `uuid`.

enum RolUsuario {
  estudiante
  docente
  comite
  administrador
  director
}

enum EstadoUsuario {
  activo
  inactivo
  bloqueado
}

enum Turno {
  manana
  tarde
}

// `password_hash` (auth-server-sessions, PR1; design.md D5/D9): nulable a propósito — un
// `Usuario` sin credencial local (p. ej. provisto solo para OAuth de #5) sigue siendo válido.
// `google_id` (google-oauth-y-recuperacion, PR1; design.md "Cambios de archivos", ADR-0017):
// aditiva, nulable y única — el `sub` del ID token de Google, completado solo cuando la cuenta
// se vincula (D3 de design.md); nunca se auto-provisiona un `Usuario` desde este valor.
// `bloqueado_hasta` (bloqueo-desbloqueo-cuentas, PR1; design.md "Cambios de archivos"): aditiva y
// nulable, mismo tipo que `creado_en` — `NULL` con `estado='bloqueado'` significa bloqueo
// indefinido (D7); el contador de intentos fallidos vive solo en Redis, nunca en esta fila.
model Usuario {
  id              String        @id @default(uuid()) @db.Uuid
  nombres         String
  dni             String        @unique
  codigo          String        @unique
  correo          String        @unique
  rol             RolUsuario
  estado          EstadoUsuario @default(activo)
  creado_en       DateTime      @default(now()) @db.Timestamptz(3)
  password_hash   String?
  google_id       String?       @unique
  bloqueado_hasta DateTime?     @db.Timestamptz(3)

  apoderados       Apoderado[]
  matriculas       Matricula[]
  derechoVotos     DerechoVoto[]
  jobsCorreo       JobCorreo[]
  eventosAuditoria EventoAuditoria[]
  // reportes-y-exportaciones (#18, PR1; design.md D2): relación inversa 1:N, sólo schema.
  reportesSolicitados Reporte[]
  // notificaciones (#19, PR1; design.md D2): relación inversa 1:N, sólo schema — bandeja interna
  // de cada usuario (usuario_id NOT NULL FK requerida).
  notificaciones      Notificacion[]
}

model Apoderado {
  id         String  @id @default(uuid()) @db.Uuid
  nombres    String
  dni        String
  correo     String?
  usuario_id String  @db.Uuid

  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
}

// NOTE: la unicidad de "a lo sumo un AnioEscolar activo" vive como índice único parcial en SQL
//       raw dentro de prisma/migrations/<ts>_identity_and_academic_tree/migration.sql — Prisma
//       no expresa índices parciales en el DSL.
model AnioEscolar {
  id     String  @id @default(uuid()) @db.Uuid
  nombre String  @unique
  activo Boolean @default(false)

  secciones       Seccion[]
  aulas           Aula[]
  matriculas      Matricula[]
  configuraciones Configuracion[]
}

model Nivel {
  id     String @id @default(uuid()) @db.Uuid
  nombre String @unique

  grados Grado[]
}

model Grado {
  id       String @id @default(uuid()) @db.Uuid
  nombre   String
  nivel_id String @db.Uuid

  nivel     Nivel     @relation(fields: [nivel_id], references: [id], onDelete: Restrict)
  secciones Seccion[]
  aulas     Aula[]

  @@unique([nivel_id, nombre])
}

model Seccion {
  id              String @id @default(uuid()) @db.Uuid
  nombre          String
  grado_id        String @db.Uuid
  anio_escolar_id String @db.Uuid

  grado       Grado       @relation(fields: [grado_id], references: [id], onDelete: Restrict)
  anioEscolar AnioEscolar @relation(fields: [anio_escolar_id], references: [id], onDelete: Restrict)
  aulas       Aula[]

  @@unique([grado_id, anio_escolar_id, nombre])
}

model Aula {
  id              String @id @default(uuid()) @db.Uuid
  turno           Turno
  grado_id        String @db.Uuid
  seccion_id      String @db.Uuid
  anio_escolar_id String @db.Uuid

  grado        Grado         @relation(fields: [grado_id], references: [id], onDelete: Restrict)
  seccion      Seccion       @relation(fields: [seccion_id], references: [id], onDelete: Restrict)
  anioEscolar  AnioEscolar   @relation(fields: [anio_escolar_id], references: [id], onDelete: Restrict)
  matriculas   Matricula[]
  procesoAulas ProcesoAula[]

  @@unique([grado_id, seccion_id, anio_escolar_id])
}

model Matricula {
  id              String @id @default(uuid()) @db.Uuid
  usuario_id      String @db.Uuid
  aula_id         String @db.Uuid
  anio_escolar_id String @db.Uuid

  usuario     Usuario     @relation(fields: [usuario_id], references: [id], onDelete: Restrict)
  aula        Aula        @relation(fields: [aula_id], references: [id], onDelete: Restrict)
  anioEscolar AnioEscolar @relation(fields: [anio_escolar_id], references: [id], onDelete: Restrict)

  @@unique([usuario_id, aula_id, anio_escolar_id])
}

// Grupo 2 — Estructura del proceso electoral (base-schema-and-migrations, tarea 2.1; design.md D1).
// `onDelete` explícito: `Cascade` en `Lista`/`Candidato`/`OpcionConsulta`/`ProcesoAula` hacia
// `ProcesoElectoral` (composición de un proceso descartable en `borrador`, sin `DerechoVoto`
// todavía); `Restrict` en `Candidato → Lista` y `ProcesoAula → Aula` (ninguno de los dos puede
// desvincularse en silencio). Sin SQL raw en este grupo (D4).

enum TipoProceso {
  municipio
  representante_aula
  padres
  consulta
}

enum EstadoProceso {
  borrador
  abierto
  cerrado
  acta_emitida
}

enum EstadoParticipacion {
  activo
  baja
}

// administracion-procesos-electorales (design.md D1): delta declarado contra este grupo. Sin
// default final (`ADD DEFAULT`+`DROP DEFAULT` en la migración es transitorio, solo para poblar
// filas preexistentes) para que omitir el campo en un `create` no compile.
enum PublicoObjetivo {
  estudiantes
  padres
  comunidad
}

enum AlcanceSegmentacion {
  institucion
  nivel
  grados
  aulas
}

model ProcesoElectoral {
  id                      String              @id @default(uuid()) @db.Uuid
  nombre                  String
  descripcion             String?
  tipo                    TipoProceso
  estado                  EstadoProceso       @default(borrador)
  fecha_apertura_prevista DateTime            @db.Timestamptz(3)
  fecha_cierre_prevista   DateTime            @db.Timestamptz(3)
  apertura_real           DateTime?           @db.Timestamptz(3)
  cierre_real             DateTime?           @db.Timestamptz(3)
  ocultar_resultados      Boolean             @default(true)
  creado_en               DateTime            @default(now()) @db.Timestamptz(3)
  publico_objetivo        PublicoObjetivo
  alcance                 AlcanceSegmentacion
  nivel_id_snapshot       String?             @db.Uuid
  grado_ids_snapshot      String[]            @default([]) @db.Uuid

  listas       Lista[]
  candidatos   Candidato[]
  opciones     OpcionConsulta[]
  procesoAulas ProcesoAula[]
  derechoVotos DerechoVoto[]
  votos        Voto[]
  actas        Acta[]
  // outbox-correo-comprobante-autenticado (#15, PR1; design.md D1): relación inversa 1:N,
  // sólo schema (sin SQL) — abre la puerta a #19 (notificaciones sin voto) sin migración adicional.
  jobsCorreo   JobCorreo[]
  // reportes-y-exportaciones (#18, PR1; design.md D2): relación inversa 1:N, sólo schema.
  reportes     Reporte[]
  // notificaciones (#19, PR1; design.md D2): relación inversa 1:N, sólo schema — `proceso_id` es
  // nullable a propósito (una notificación futura sin proceso asociado no colisiona en dedup).
  notificaciones Notificacion[]
}

model Lista {
  id                   String              @id @default(uuid()) @db.Uuid
  proceso_id           String              @db.Uuid
  nombre               String
  numero               Int
  simbolo              String?
  lema                 String?
  propuesta            String?
  plan_trabajo         Bytes?
  plan_trabajo_mime    String?
  plan_trabajo_nombre  String?
  estado               EstadoParticipacion @default(activo)
  baja_en              DateTime?           @db.Timestamptz(3)

  proceso    ProcesoElectoral @relation(fields: [proceso_id], references: [id], onDelete: Cascade)
  candidatos Candidato[]
  votos      Voto[]

  @@unique([proceso_id, numero])
}

model Candidato {
  id         String              @id @default(uuid()) @db.Uuid
  proceso_id String              @db.Uuid
  lista_id   String?             @db.Uuid
  nombres    String
  grado      String?
  aula       String?
  cargo      String?
  foto       Bytes?
  foto_mime  String?
  estado     EstadoParticipacion @default(activo)
  baja_en    DateTime?           @db.Timestamptz(3)

  proceso ProcesoElectoral @relation(fields: [proceso_id], references: [id], onDelete: Cascade)
  lista   Lista?           @relation(fields: [lista_id], references: [id], onDelete: Restrict)
  votos   Voto[]
}

model OpcionConsulta {
  id          String  @id @default(uuid()) @db.Uuid
  proceso_id  String  @db.Uuid
  etiqueta    String
  descripcion String?

  proceso ProcesoElectoral @relation(fields: [proceso_id], references: [id], onDelete: Cascade)
  votos   Voto[]

  @@unique([proceso_id, etiqueta])
}

model ProcesoAula {
  id         String @id @default(uuid()) @db.Uuid
  proceso_id String @db.Uuid
  aula_id    String @db.Uuid

  proceso ProcesoElectoral @relation(fields: [proceso_id], references: [id], onDelete: Cascade)
  aula    Aula             @relation(fields: [aula_id], references: [id], onDelete: Restrict)

  @@unique([proceso_id, aula_id])
}

// Grupo 3 — Núcleo de votación (base-schema-and-migrations, tarea 3.1; design.md D1/D5).
// `onDelete: Restrict` explícito en TODAS las relaciones — ningún camino de borrado alcanza
// `DerechoVoto` ni `Voto` (ADR-0003, ADR-0010). En particular, `Voto → Lista/OpcionConsulta/
// Candidato` anula el `SetNull` por omisión de Prisma en relaciones opcionales (design.md D1,
// "Gotcha que obliga a ser explícito").

model DerechoVoto {
  id            String @id @default(uuid()) @db.Uuid
  proceso_id    String @db.Uuid
  usuario_id    String @db.Uuid
  en_calidad_de String
  // D2 (apertura-proceso-congelamiento-padron): espejo plano de ProcesoAula.aula_id, sin FK ni
  // relación Prisma deliberadamente (ADR-0003/ADR-0010 — inmutabilidad de la congelación).
  aula_snapshot String @db.Uuid

  proceso ProcesoElectoral @relation(fields: [proceso_id], references: [id], onDelete: Restrict)
  usuario Usuario          @relation(fields: [usuario_id], references: [id], onDelete: Restrict)
  votos   Voto[]

  // D1 (apertura-proceso-congelamiento-padron): unicidad por proceso+usuario+calidad, permite
  // hasta dos filas por cuenta en alcance `comunidad` (estudiante + padre) y actúa como red de
  // seguridad final ante condiciones de carrera en reintentos concurrentes de apertura.
  @@unique([proceso_id, usuario_id, en_calidad_de])
}

// NOTE: `exactamente una elección` vive como CHECK en SQL raw dentro de
//       prisma/migrations/<ts>_voting_core/migration.sql — Prisma no expresa CHECK.
model Voto {
  id                 String   @id @default(uuid()) @db.Uuid
  proceso_id         String   @db.Uuid
  derecho_voto_id    String   @db.Uuid
  lista_id           String?  @db.Uuid
  opcion_id          String?  @db.Uuid
  candidato_id       String?  @db.Uuid
  blanco             Boolean  @default(false)
  codigo_comprobante String   @unique
  clave_idempotencia String
  hora_servidor      DateTime @default(now()) @db.Timestamptz(3)

  proceso     ProcesoElectoral @relation(fields: [proceso_id], references: [id], onDelete: Restrict)
  derechoVoto DerechoVoto      @relation(fields: [derecho_voto_id], references: [id], onDelete: Restrict)
  lista       Lista?           @relation(fields: [lista_id], references: [id], onDelete: Restrict)
  opcion      OpcionConsulta?  @relation(fields: [opcion_id], references: [id], onDelete: Restrict)
  candidato   Candidato?       @relation(fields: [candidato_id], references: [id], onDelete: Restrict)
  // outbox-correo-comprobante-autenticado (#15, PR1; design.md D1): relación inversa 1:1 opcional,
  // sólo schema (sin SQL) — el UNIQUE vive del lado de JobCorreo.voto_id.
  jobCorreo   JobCorreo?

  @@unique([proceso_id, derecho_voto_id])
  @@unique([proceso_id, clave_idempotencia])
}

// Grupo 4 — Tablas de soporte (base-schema-and-migrations, tarea 4.1; design.md D1/D7).
// `onDelete: Restrict` en toda relación (artefactos probatorios y singleton institucional, sin
// composición descartable). Sin SQL raw en este grupo (D4). `Configuracion` NO lleva ninguna
// columna de secreto SMTP (D7): solo `smtp_host`/`smtp_puerto`/`smtp_remitente` — la contraseña
// vendrá de variable de entorno o gestor de secretos, decisión de #10.

enum EstadoJobCorreo {
  pendiente
  enviado
  fallido
}

// notificaciones (#19, PR1; design.md D2): `interna` agregado de forma aditiva (`ALTER TYPE ...
// ADD VALUE`) — `correo` conserva nombre y orden (spec "Migración no toca columnas ni valores
// existentes").
enum TipoNotificacion {
  correo
  interna
}

// notificaciones (#19, PR1; design.md D2/C3): enum de EVENTO, distinto del canal (`TipoNotificacion`).
// Los 4 eventos del ciclo de vida del proceso electoral que dispara este change.
enum EventoNotificacion {
  inicio_votacion
  recordatorio
  cierre_proximo
  resultados
}

// notificaciones (#19, PR1; design.md D3, corrige C5): discriminante real de la cola BullMQ —
// sin esta columna, `outbox-correo.repo.ts::pendientes()` no distingue comprobantes de
// recordatorios y la cola dedicada `notificaciones` es decorativa.
enum OrigenJobCorreo {
  comprobante
  notificacion
}

// cierre-escrutinio-actas (#17, PR1; design.md D2): `escrutinio`/`oficial` agregados; `resultados`
// queda deprecado (Postgres no permite DROP VALUE) y su uso se prohíbe con un CHECK a nivel de
// tabla (ver `Acta.acta_tipo_no_deprecado_chk` abajo), no reciclado por ningún código nuevo.
enum TipoActa {
  apertura
  cierre
  resultados
  escrutinio
  oficial
}

// cierre-escrutinio-actas (#17, PR1; design.md D2/D7): `fallido` en paridad exacta con
// `EstadoJobCorreo` — el worker lo escribe sólo tras agotar los reintentos nativos de BullMQ.
enum EstadoActa {
  borrador
  emitida
  fallido
}

model JobCorreo {
  id                 String          @id @default(uuid()) @db.Uuid
  usuario_id         String          @db.Uuid
  asunto             String
  cuerpo             String
  estado             EstadoJobCorreo @default(pendiente)
  intentos           Int             @default(0)
  creado_en          DateTime        @default(now()) @db.Timestamptz(3)
  // outbox-correo-comprobante-autenticado (#15, PR1; design.md D1): columnas aditivas nullable —
  // convierten la tabla en un outbox consultable con un JOIN (ADR-0012), en vez de texto libre.
  // `voto_id` lleva FK real y UNIQUE: "cada voto confirmado genera exactamente un job" pasa de ser
  // una promesa del código a una restricción del motor.
  voto_id            String?         @unique @db.Uuid
  proceso_id         String?         @db.Uuid
  codigo_comprobante String?
  // notificaciones (#19, PR1; design.md D3, corrige C5): discriminante de cola. `DEFAULT
  // 'comprobante'` clasifica correctamente todas las filas preexistentes sin backfill.
  origen             OrigenJobCorreo @default(comprobante)

  usuario        Usuario           @relation(fields: [usuario_id], references: [id], onDelete: Restrict)
  voto           Voto?             @relation(fields: [voto_id], references: [id], onDelete: Restrict)
  proceso        ProcesoElectoral? @relation(fields: [proceso_id], references: [id], onDelete: Restrict)
  notificaciones Notificacion[]

  @@index([estado, creado_en])
}

// notificaciones (#19, PR1; design.md D2/C3/C4/C6): `Notificacion` gana el eje que no tenía
// (`proceso_id`/`evento`/`usuario_id`) más el contenido de bandeja (`titulo`/`cuerpo`/`leido_en`).
// `job_correo_id` pasa a nullable (una notificación interna puede existir sin correo asociado).
// `proceso_id` es nullable A PROPÓSITO: Postgres trata NULL como distinto en el índice único, así
// que una notificación futura sin proceso jamás colisiona con la clave de dedup.
model Notificacion {
  id            String              @id @default(uuid()) @db.Uuid
  job_correo_id String?             @db.Uuid
  tipo          TipoNotificacion    @default(correo)
  creado_en     DateTime            @default(now()) @db.Timestamptz(3)
  usuario_id    String              @db.Uuid
  proceso_id    String?             @db.Uuid
  evento        EventoNotificacion
  titulo        String
  cuerpo        String
  leido_en      DateTime?           @db.Timestamptz(3)

  jobCorreo JobCorreo?        @relation(fields: [job_correo_id], references: [id], onDelete: Restrict)
  usuario   Usuario           @relation(fields: [usuario_id], references: [id], onDelete: Restrict)
  proceso   ProcesoElectoral? @relation(fields: [proceso_id], references: [id], onDelete: Restrict)

  // D2/C4: clave de deduplicación del sweep — una por (proceso, evento, usuario).
  @@unique([proceso_id, evento, usuario_id])
  @@index([usuario_id, creado_en(sort: Desc)])
}

// configuracion-general, PR1 (design.md D1, tarea 1.2). Columnas aditivas, todas nullable o con
// default que no requiere valor en filas existentes — la fila semilla `clave='institucional'`
// sobrevive la migración sin tocarse. `logo`/`logo_mime`/`logo_actualizado_en` quedan fuera de
// este PR (se agregan en PR3, junto con la subida/servido del logo) para mantener esta migración
// acotada al alcance de `ConfiguracionLecturaModule` (lectura de identidad textual, colores, zona
// horaria y dominios Google — sin bytea todavía).
// configuracion-general, PR3 (design.md D5, tarea 3.0). `logo`/`logo_mime`/`logo_actualizado_en`
// diferidas de PR1 (ver comentario arriba y la DESVIACIÓN documentada en tasks.md, tarea 1.2):
// migración propia de este PR, columnas nullable — la fila semilla sigue sin tocarse.
model Configuracion {
  id                  String    @id @default(uuid()) @db.Uuid
  clave               String    @unique
  anio_escolar_id     String    @db.Uuid
  smtp_host           String?
  smtp_puerto         Int?
  smtp_remitente      String?
  nombre              String?
  director            String?
  color_primario      String?
  color_secundario    String?
  zona_horaria        String?
  dominios_google     String[]  @default([])
  logo                Bytes?
  logo_mime           String?
  logo_actualizado_en DateTime? @db.Timestamptz(3)
  actualizado_en      DateTime  @default(now()) @db.Timestamptz(3)

  anioEscolar AnioEscolar @relation(fields: [anio_escolar_id], references: [id], onDelete: Restrict)
}

// cierre-escrutinio-actas (#17, PR1; design.md D2/D3): `contenido` pasa de TEXT a JSONB (snapshot
// estructurado del cierre, D6), +`pdf`/+`pdf_mime` (mismo patrón que `Lista.plan_trabajo`/
// `Candidato.foto`), `@@unique([proceso_id, tipo])` (red final contra un doble cierre) y
// `@@index([estado, creado_en])` (consulta caliente del dispatcher de actas, D10).
model Acta {
  id         String     @id @default(uuid()) @db.Uuid
  proceso_id String     @db.Uuid
  tipo       TipoActa
  estado     EstadoActa @default(borrador)
  contenido  Json       @db.JsonB
  pdf        Bytes?
  pdf_mime   String?
  creado_en  DateTime   @default(now()) @db.Timestamptz(3)

  proceso ProcesoElectoral @relation(fields: [proceso_id], references: [id], onDelete: Restrict)

  @@unique([proceso_id, tipo])
  @@index([estado, creado_en])
}

// Grupo 5 — Motor de auditoría append-only (append-only-audit-engine, PR1; design.md D1/D2/D3).
// `onDelete: Restrict` explícito en `actor_usuario_id` (anula el `SetNull` por omisión de Prisma
// en relaciones opcionales — mismo gotcha que D1 de #2): un `DELETE` sobre `Usuario` no puede
// vaciar en silencio la autoría de un evento. `event_type`/`entity_type` son `TEXT` (convención
// impuesta por `CHECK`, no `ENUM` — D7); `entity_id` es `TEXT` porque direcciona entidades
// heterogéneas y ninguna FK es posible. Sin índices adicionales: la tabla nace vacía y el camino
// de lectura lo define #21 (D1).
model EventoAuditoria {
  id               String   @id @default(uuid()) @db.Uuid
  actor_usuario_id String?  @db.Uuid
  event_type       String
  entity_type      String
  entity_id        String?
  occurred_at      DateTime @default(now()) @db.Timestamptz(3)
  ip_address       String?  @db.Inet
  user_agent       String?
  payload          Json     @db.JsonB

  actor Usuario? @relation(fields: [actor_usuario_id], references: [id], onDelete: Restrict)
}

// reportes-y-exportaciones (#18, PR1; design.md D2/D3). Grupo nuevo, 100% aditivo: ningún tipo ni
// tabla existente cambia.
enum DimensionReporte {
  participacion
  votantes
  abstenciones
  resultados
  candidatos
  consultas
}

enum FormatoReporte {
  excel
  pdf
  csv
}

// Paridad exacta con EstadoActa (#17 D2): el worker escribe 'fallido' solo tras agotar reintentos.
enum EstadoReporte {
  borrador
  emitida
  fallido
}

/// D3: la AUSENCIA de @@unique([proceso_id, dimension, formato]) es DELIBERADA — al revés que
/// Acta (1 por tipo por proceso), cada solicitud es su propio snapshot inmutable. No agregarla.
model Reporte {
  id             String           @id @default(uuid()) @db.Uuid
  proceso_id     String           @db.Uuid
  dimension      DimensionReporte
  formato        FormatoReporte
  estado         EstadoReporte    @default(borrador)
  /// D2/D13: NOT NULL a propósito — único camino del actor hasta REPORTE_GENERADO.
  solicitado_por String           @db.Uuid
  /// D7: null mientras 'borrador'; lo escribe el worker con el gate EFECTIVO de la generación.
  gate_aplicado  Boolean?
  contenido      Json             @db.JsonB
  archivo        Bytes?
  archivo_mime   String?
  archivo_nombre String?
  creado_en      DateTime         @default(now()) @db.Timestamptz(3)
  emitido_en     DateTime?        @db.Timestamptz(3)

  proceso     ProcesoElectoral @relation(fields: [proceso_id], references: [id], onDelete: Restrict)
  solicitante Usuario          @relation(fields: [solicitado_por], references: [id], onDelete: Restrict)

  @@index([estado, creado_en])
  @@index([proceso_id, dimension, formato, creado_en])
}
