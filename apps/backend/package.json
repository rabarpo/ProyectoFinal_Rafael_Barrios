{
  "name": "@seei/backend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "test": "jest --config jest.config.ts",
    "test:e2e": "node scripts/test-e2e.mjs",
    "test:schema": "jest --config test/schema/jest-schema.config.ts",
    "db:seed": "tsx prisma/seed.ts",
    "check:drift": "bash scripts/check-migration-drift.sh",
    "lint": "echo \"@seei/backend: nothing to lint yet\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "openapi:extract": "tsx src/openapi.ts",
    "postinstall": "prisma generate --allow-no-models"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^8.1.1",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^5.22.0",
    "bullmq": "^5.34.5",
    "cookie-parser": "^1.4.7",
    "ioredis": "^5.4.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/testing": "^10.4.15",
    "@types/cookie-parser": "^1.4.10",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "jest": "^29.7.0",
    "pg": "^8.13.1",
    "prisma": "^5.22.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
