# Plantilla versionada — NUNCA secretos reales. Copiar a `.env` (ignorado por git) y completar
# con contrasenas propias para desarrollo local. Ver design.md, seccion "Modelo de roles de
# PostgreSQL" y "Cadenas de conexion".

# Contrasena del superusuario de bootstrap `postgres` (nunca usado por ninguna aplicacion).
POSTGRES_PASSWORD=changeme_postgres

# Rol propietario/DDL, usado exclusivamente por `prisma migrate` y el servicio one-shot `migrate`.
SEEI_MIGRATOR_PASSWORD=changeme_migrator

# Rol de runtime (DML por privilegios por defecto), usado por `backend` y `worker`.
SEEI_APP_PASSWORD=changeme_app

# Prisma Client (backend, worker) -> rol de runtime `seei_app`.
# Host `postgres`: nombre del servicio en la relhost` — estas
# variables las consumen los contenedores `backend`/`worker`/`migrate`, no el host).
DATABASE_URL=postgresql://seei_app:changeme_app@postgres:5432/seei?schema=public

# `prisma migrate` / servicio `migrate` -> rol propietario `seei_migrator`.
MIGRATION_DATABASE_URL=postgresql://seei_migrator:changeme_migrator@postgres:5432/seei?schema=public

REDIS_URL=redis://redis:6379