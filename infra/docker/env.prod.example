# Plantilla del archivo de entorno de PRODUCCIÓN.
#
# Nombre sin punto inicial a propósito (para que sea versionable y visible); la copia REAL en el
# VPS se llama `.env`:
#
#   cp infra/docker/env.prod.example /opt/seei/.env
#   chmod 600 /opt/seei/.env && chown root:root /opt/seei/.env
#   # y reemplazar cada CAMBIAR_* con un valor real
#
# /opt/seei/.env vive fuera de git (root, chmod 600). Docker Compose lo carga automáticamente por
# estar en el directorio del proyecto.
#
# Contraseñas: generarlas con  openssl rand -base64 32  — nunca reusar las de .env.test/.dev.

# ─────────────────────────────────────────────────────────────────────────────
# SECRETOS — PostgreSQL
# ─────────────────────────────────────────────────────────────────────────────
# Consumidas por el entrypoint de postgres:16-alpine (infra/docker/postgres/init/01-roles.sql)
# SOLO la primera vez que se inicializa el volumen `pgdata`. Si cambian después, hay que rotar
# los roles a mano dentro de Postgres (el init no se re-ejecuta).
POSTGRES_PASSWORD=CAMBIAR_superusuario_bootstrap
SEEI_MIGRATOR_PASSWORD=CAMBIAR_rol_migrador
SEEI_APP_PASSWORD=CAMBIAR_rol_aplicacion

# ─────────────────────────────────────────────────────────────────────────────
# SECRETOS — Cadenas de conexión (host `postgres` / `redis`: red interna del compose)
# ─────────────────────────────────────────────────────────────────────────────
# Runtime (backend + worker): rol seei_app, SIN privilegios de DDL.
DATABASE_URL=postgresql://seei_app:CAMBIAR_rol_aplicacion@postgres:5432/seei?schema=public
# Solo el servicio `migrate`: rol seei_migrator, propietario del esquema.
MIGRATION_DATABASE_URL=postgresql://seei_migrator:CAMBIAR_rol_migrador@postgres:5432/seei?schema=public
REDIS_URL=redis://redis:6379

# ─────────────────────────────────────────────────────────────────────────────
# SECRETOS — Google OAuth y SMTP
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=CAMBIAR.apps.googleusercontent.com
# Credenciales SMTP de Google Workspace. El host/puerto/remitente SMTP se leen de la tabla
# `Configuracion` en Postgres; la contraseña NUNCA sale de esa tabla.
SMTP_USER=CAMBIAR@ejemplo.edu.pe
SMTP_PASSWORD=CAMBIAR_app_password_google

# ─────────────────────────────────────────────────────────────────────────────
# CONFIG (no son secretos)
# ─────────────────────────────────────────────────────────────────────────────
# Base del enlace autenticado que viaja en el correo de comprobante. DEBE ser el dominio real.
APP_BASE_URL=https://seei.ejemplo.edu.pe
# Dominio(s) institucional(es) permitidos en el login con Google (ADR-0017). Separados por coma.
GOOGLE_HOSTED_DOMAINS=ejemplo.edu.pe

# Políticas de login (el backend cae a sus defaults si se omiten).
RECOVERY_TTL_SECONDS=86400
LOGIN_INTENTOS_MAX=5
LOGIN_INTENTOS_VENTANA_SEGUNDOS=300
LOGIN_BLOQUEO_SEGUNDOS=900

# Caché corta de resultados en vivo (ADR-0005; default 8 s).
RESULTADOS_CACHE_TTL_SECONDS=8

# Despachadores de outbox del worker (polling). Todos opcionales — defaults 5000 ms / lote 20.
OUTBOX_POLL_MS=5000
OUTBOX_BATCH=20
ACTAS_POLL_MS=5000
ACTAS_BATCH=20
REPORTES_POLL_MS=5000
REPORTES_BATCH=20
NOTIFICACIONES_POLL_MS=5000
NOTIFICACIONES_BATCH=20
NOTIFICACIONES_SWEEP_MS=60000
NOTIFICACIONES_RECORDATORIO_HORAS=24
NOTIFICACIONES_CIERRE_PROXIMO_HORAS=2
