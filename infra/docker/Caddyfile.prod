# Caddyfile de PRODUCCIÓN. Se monta en el servicio `caddy` vía docker-compose.prod.yml,
# reemplazando el Caddyfile del compose base (que usa `tls internal` + seei.localhost para dev).
#
# Requisitos antes del primer deploy (ver infra/PROVISIONING.md):
#   - El dominio de abajo debe resolver por DNS (registro A) a la IP pública del VPS.
#   - Los puertos 80 y 443 del VPS deben estar abiertos a Internet (Caddy resuelve el desafío
#     ACME de Let's Encrypt por el puerto 80).
#
# Sustituir `seei.ejemplo.edu.pe` por el dominio real y `admin@ejemplo.edu.pe` por un correo
# monitoreado (Let's Encrypt avisa ahí si un certificado no se renueva).
{
	email admin@ejemplo.edu.pe
	# Descomentar para probar contra el entorno de staging de Let's Encrypt sin gastar la cuota
	# de rate-limit del entorno de producción:
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

seei.ejemplo.edu.pe {
	# Certificado real de Let's Encrypt (HTTP-01). Renovación automática.
	tls admin@ejemplo.edu.pe

	encode gzip zstd

	header {
		# HSTS: fuerza HTTPS en el navegador por 1 año. NO activar `preload` hasta estar
		# seguro de no volver a HTTP (es difícil de revertir).
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Caddy agrega su versión en `Server:` por defecto; ocultarla.
		-Server
	}

	# Mismo ruteo que el Caddyfile base: sitio único, la API comparte origen con la SPA porque
	# el backend fija `app.setGlobalPrefix('api')`.
	handle /api/* {
		reverse_proxy backend:3000
	}

	handle {
		reverse_proxy frontend:8080
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 5
			roll_keep_for 720h
		}
		format json
	}
}
